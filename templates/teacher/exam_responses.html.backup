{% extends 'base.html' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h1 class="text-4xl font-bold text-gray-900 mb-2">📋 Exam Responses Dashboard</h1>
                    <p class="text-lg text-gray-600">Review all student exam responses (Google Forms style)</p>
                </div>
                <a href="{% url 'teacher_dashboard' %}" class="inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Back to Dashboard
                </a>
            </div>

            {% if not no_classes %}
            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-white rounded-xl shadow-lg p-4 border-t-4 border-blue-500">
                    <p class="text-xs text-gray-600 mb-1">Unique Responses</p>
                    <p class="text-3xl font-bold text-gray-900">{{ unique_responses }}</p>
                    <p class="text-xs text-gray-500 mt-1">Student-exam combinations</p>
                </div>
                
                <div class="bg-white rounded-xl shadow-lg p-4 border-t-4 border-purple-500">
                    <p class="text-xs text-gray-600 mb-1">Total Attempts</p>
                    <p class="text-3xl font-bold text-purple-600">{{ total_attempts }}</p>
                    <p class="text-xs text-gray-500 mt-1">Including retakes</p>
                </div>
                
                <div class="bg-white rounded-xl shadow-lg p-4 border-t-4 border-green-500">
                    <p class="text-xs text-gray-600 mb-1">Average Score</p>
                    <p class="text-3xl font-bold text-green-600">{{ avg_percentage }}%</p>
                    <p class="text-xs text-gray-500 mt-1">Across all attempts</p>
                </div>
                
                <div class="bg-white rounded-xl shadow-lg p-4 border-t-4 border-yellow-500">
                    <p class="text-xs text-gray-600 mb-1">Pass Rate</p>
                    <p class="text-3xl font-bold text-yellow-600">{{ pass_rate }}%</p>
                    <p class="text-xs text-gray-500 mt-1">Students passing</p>
                </div>
            </div>

            <!-- Filters and Organization -->
            <div class="bg-white rounded-lg shadow p-6 mb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">🔍 Filter Responses</h3>
                <form method="GET">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                        <!-- Class Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Class</label>
                            <select name="class_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                                <option value="">All Classes</option>
                                {% for class in teacher_classes %}
                                <option value="{{ class.id }}" {% if selected_class and selected_class.id == class.id %}selected{% endif %}>
                                    {{ class.name }} ({{ class.year }})
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <!-- Exam Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Exam</label>
                            <select name="exam_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <option value="">All Exams</option>
                                {% for exam in class_exams %}
                                <option value="{{ exam.id }}" {% if selected_exam and selected_exam.id == exam.id %}selected{% endif %}>
                                    {{ exam.title }} ({{ exam.subject }})
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <!-- Student Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Student</label>
                            <select name="student_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="">All Students</option>
                                {% for student in all_students %}
                                <option value="{{ student.id }}" {% if selected_student and selected_student.id == student.id %}selected{% endif %}>
                                    {{ student.get_full_name|default:student.email }}
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <!-- Sort By -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">📊 Sort By</label>
                            <select name="sort" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500">
                                <option value="recent" {% if sort_by == 'recent' %}selected{% endif %}>Most Recent</option>
                                <option value="score_high" {% if sort_by == 'score_high' %}selected{% endif %}>Highest Score</option>
                                <option value="score_low" {% if sort_by == 'score_low' %}selected{% endif %}>Lowest Score</option>
                                <option value="student_name" {% if sort_by == 'student_name' %}selected{% endif %}>Student Name (A-Z)</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Submit Button -->
                    <div class="flex gap-3">
                        <button type="submit" class="px-6 py-2 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition">
                            Apply Filters
                        </button>
                        <a href="{% url 'teacher_exam_responses' %}" class="px-6 py-2 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition">
                            Clear All
                        </a>
                    </div>
                </form>
            </div>

            <!-- Organized Responses -->
            <div class="space-y-4">
                {% if page_obj %}
                {% for response in page_obj %}
                <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition">
                    <!-- Response Header -->
                    <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-6 py-4">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <div class="h-12 w-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-white font-bold text-lg">
                                        {{ response.student.first_name.0|default:response.student.email.0|upper }}
                                    </div>
                                    <div>
                                        <h3 class="text-xl font-bold text-white">{{ response.student.get_full_name|default:response.student.email }}</h3>
                                        <p class="text-sm text-indigo-100">{{ response.exam.title }} • {{ response.exam.subject }}</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 text-sm text-indigo-100">
                                    <span>📚 {{ response.student_class.name }}</span>
                                    <span>📝 {{ response.attempt_count }} attempt{{ response.attempt_count|pluralize }}</span>
                                    <span>🕒 Latest: {{ response.latest_submitted|date:"M d, Y" }}</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2 mb-2">
                                    <p class="text-xs text-indigo-100">Best Score</p>
                                    <p class="text-3xl font-bold text-white">{{ response.best_percentage }}%</p>
                                </div>
                                {% if response.improvement is not None %}
                                <div class="text-xs {% if response.improvement > 0 %}text-green-200{% elif response.improvement < 0 %}text-red-200{% else %}text-indigo-200{% endif %}">
                                    {% if response.improvement > 0 %}⬆{% elif response.improvement < 0 %}⬇{% else %}→{% endif %}
                                    {% if response.improvement > 0 %}+{% endif %}{{ response.improvement }}% improvement
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Attempt Details (Expandable) -->
                    <div class="p-6">
                        <div class="grid grid-cols-3 gap-4 mb-4 pb-4 border-b border-gray-200">
                            <div class="text-center">
                                <p class="text-xs text-gray-500 mb-1">Best Score</p>
                                <p class="text-2xl font-bold text-green-600">{{ response.best_percentage }}%</p>
                                <p class="text-xs text-gray-500">{{ response.best_attempt.score }}/{{ response.best_attempt.total_marks }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-gray-500 mb-1">Average</p>
                                <p class="text-2xl font-bold text-gray-900">{{ response.avg_percentage }}%</p>
                                <p class="text-xs text-gray-500">Across {{ response.attempt_count }} attempt{{ response.attempt_count|pluralize }}</p>
                            </div>
                            <div class="text-center">
                                <p class="text-xs text-gray-500 mb-1">Latest Score</p>
                                <p class="text-2xl font-bold {% if response.latest_attempt.passed %}text-green-600{% else %}text-red-600{% endif %}">
                                    {{ response.latest_attempt.percentage|floatformat:1 }}%
                                </p>
                                <p class="text-xs text-gray-500">{{ response.latest_attempt.score }}/{{ response.latest_attempt.total_marks }}</p>
                            </div>
                        </div>
                        
                        <!-- All Attempts List -->
                        <div class="space-y-2">
                            <p class="text-sm font-semibold text-gray-700 mb-3">📋 All Attempts ({{ response.attempt_count }}):</p>
                            {% for attempt in response.attempts %}
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition {% if forloop.first %}border-2 border-indigo-200{% endif %}">
                                <div class="flex items-center gap-3">
                                    <div class="flex items-center justify-center h-8 w-8 rounded-full {% if forloop.first %}bg-gradient-to-r from-indigo-500 to-purple-600{% else %}bg-gray-300{% endif %} text-white font-bold text-xs">
                                        #{{ forloop.counter }}
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-900">
                                            {{ attempt.submitted_at|date:"M d, Y - g:i A" }}
                                            {% if forloop.first %}
                                            <span class="ml-2 px-2 py-0.5 bg-indigo-100 text-indigo-800 text-xs rounded-full font-bold">Latest</span>
                                            {% endif %}
                                        </p>
                                        <p class="text-xs text-gray-500">
                                            {% if attempt.time_taken %}{{ attempt.time_taken|floatformat:0 }} minutes{% else %}Time not recorded{% endif %}
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="text-right">
                                        <p class="text-lg font-bold {% if attempt.passed %}text-green-600{% else %}text-red-600{% endif %}">
                                            {{ attempt.percentage|floatformat:1 }}%
                                        </p>
                                        <p class="text-xs text-gray-500">{{ attempt.score }}/{{ attempt.total_marks }} marks</p>
                                    </div>
                                    <span class="px-3 py-1 rounded-full text-xs font-bold {% if attempt.passed %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                        {% if attempt.passed %}✓ Pass{% else %}✗ Fail{% endif %}
                                    </span>
                                    <a href="{% url 'teacher_view_attempt' attempt.pk %}" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition">
                                        Review
                                    </a>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endfor %}
                {% else %}
                <div class="bg-white rounded-xl shadow-lg p-12 text-center">
                    <div class="bg-gray-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">No Responses Found</h3>
                    <p class="text-gray-600">Wait for students to complete exams or adjust your filters</p>
                </div>
                {% endif %}
            </div>
            
            <!-- Pagination -->
            {% if page_obj.has_other_pages %}
            <div class="bg-white rounded-lg shadow px-6 py-4 mt-6">
                <div class="flex items-center justify-between">
                    <div class="text-sm text-gray-700">
                        Showing {{ page_obj.start_index }} to {{ page_obj.end_index }} of {{ page_obj.paginator.count }} response{{ page_obj.paginator.count|pluralize }}
                    </div>
                    <div class="flex gap-2">
                        {% if page_obj.has_previous %}
                        <a href="?page={{ page_obj.previous_page_number }}{% if request.GET.class_id %}&class_id={{ request.GET.class_id }}{% endif %}{% if request.GET.exam_id %}&exam_id={{ request.GET.exam_id }}{% endif %}{% if request.GET.student_id %}&student_id={{ request.GET.student_id }}{% endif %}{% if request.GET.sort %}&sort={{ request.GET.sort }}{% endif %}" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                            Previous
                        </a>
                        {% endif %}
                        <span class="px-4 py-2 bg-gray-100 rounded-lg">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
                        {% if page_obj.has_next %}
                        <a href="?page={{ page_obj.next_page_number }}{% if request.GET.class_id %}&class_id={{ request.GET.class_id }}{% endif %}{% if request.GET.exam_id %}&exam_id={{ request.GET.exam_id }}{% endif %}{% if request.GET.student_id %}&student_id={{ request.GET.student_id }}{% endif %}{% if request.GET.sort %}&sort={{ request.GET.sort }}{% endif %}" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                            Next
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
            {% else %}
            <!-- No Classes State -->
            <div class="bg-white rounded-xl shadow-lg p-12 text-center">
                <div class="bg-gray-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No Classes Created</h3>
                <p class="text-gray-600 mb-6">Create classes and assign exams to start tracking responses</p>
                <a href="{% url 'class_list' %}" class="inline-flex items-center px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition">
                    Manage Classes
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
